#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

DISK_LIST="s_disks"

while read -r disk; do
    [[ -z "$disk" ]] && continue

    if [[ ! -b "$disk" ]]; then
        echo "Uyarı: $disk blok aygıtı yok, atlanıyor."
        continue
    fi

    echo "SMART short testi başlatılıyor: $disk"
    smartctl -t short "$disk"
done < "$DISK_LIST"
